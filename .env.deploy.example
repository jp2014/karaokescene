# Copy to .env.deploy (git-ignored). Never put service keys in VITE_* settings.
# CLI login: pnpm exec supabase login; pnpm exec wrangler login
# CI can use SUPABASE_ACCESS_TOKEN, CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Dashboard → API Keys → publishable key (or legacy anon key), public by design
SUPABASE_ANON_KEY=

# Cloudflare account ID (dashboard) and Worker name. The first deploy can create the Worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=karaokescene
# Your actual workers.dev URL or custom domain
SITE_URL=https://karaokescene.<your-subdomain>.workers.dev
SCENE_TZ=America/Chicago

# Auth setup is separate: set production Site URL and redirect URLs in Supabase,
# paste supabase/templates/email-code.html into both confirmation + magic-link templates,
# configure custom SMTP, and enable Google with its OAuth app credentials.
# Do not push the local supabase/config.toml Auth URLs into production.
# Leave Firebase settings unset for launch (push is dormant).
