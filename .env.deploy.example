# Copy to .env.deploy (git-ignored) and fill in, then run `pnpm release`.
# CLI auth: run `npx supabase@2 login` and `npx netlify-cli@27 login` once,
# or set SUPABASE_ACCESS_TOKEN / NETLIFY_AUTH_TOKEN here (for CI).

# Supabase project (Dashboard → Project Settings)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Netlify site ID (Site configuration → Site details)
NETLIFY_SITE_ID=
# Public URL of the PWA: used for CORS, push notification links and OAuth redirects
SITE_URL=https://kareokescene.netlify.app

# Optional
# ALLOWED_ORIGINS=https://kareokescene.netlify.app,https://karaokescene.app
# SCENE_TZ=America/Chicago

# Push notifications (optional). Firebase console → Project settings.
# Service account key JSON (Service accounts → Generate new private key); keep it out of git.
# FCM_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# Web app config + Cloud Messaging → Web Push certificates (VAPID key)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
