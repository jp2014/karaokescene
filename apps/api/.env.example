# Optional: everything works locally without this file (PGlite, local realtime/storage, demo personas).
# Copy to apps/api/.env to point the local API at real services.

# A real Postgres instead of the embedded one
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Real Supabase Auth / Realtime / Storage (also set VITE_SUPABASE_* in apps/web/.env.local)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# DEMO=off   # disable personas, seeding and Demo controls
